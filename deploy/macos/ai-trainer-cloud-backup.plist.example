<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.ai-trainer.cloud-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/EXISTING/ai_trainer/ai_trainer_env/bin/python</string>
    <string>/ABSOLUTE/EXISTING/ai_trainer/scripts/cloud_backup.py</string>
    <string>run</string>
    <string>--config</string>
    <string>/ABSOLUTE/PRIVATE/cloud/config.json</string>
  </array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/EXISTING/ai_trainer</string>
  <key>RunAtLoad</key><true/>
  <key>StartCalendarInterval</key><dict><key>Minute</key><integer>0</integer></dict>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
