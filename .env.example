# AI Провайдеры (выберите один или несколько)

# OpenAI (GPT-3.5/GPT-4)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Google (Gemini) - новые модели 2024-2025
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=models/gemini-1.5-flash-latest

# Ollama (локальные модели) - рекомендуемые модели:
# llama3.1:8b - универсальная модель (4.9GB)
# gemma3:latest - быстрая модель (3.3GB) 
# deepseek-r1:7b - хорошая для рассуждений (4.7GB)
# tinyllama:latest - очень быстрая, маленькая (637MB)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Провайдер по умолчанию (openai, anthropic, google, ollama)
DEFAULT_AI_PROVIDER=ollama

# Garmin Connect credentials (опционально - можно вводить в UI)
GARMIN_EMAIL=your_garmin_email@example.com
GARMIN_PASSWORD=your_garmin_password

# Настройки базы данных
DATABASE_PATH=ai_trainer.db

# Dev-only sidebar tools (0 = hidden in product flow, 1 = show)
SHOW_DEVELOPMENT_TOOLS=0

# Пороги пользователя (опционально)
USER_FTP=250
USER_LTHR=170
USER_MAX_HR=185
