# AI Провайдеры (выберите один или несколько)

# OpenAI (GPT-3.5/GPT-4)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# DeepSeek (OpenAI-compatible API)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Google (Gemini) - новые модели 2024-2025
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=models/gemini-1.5-flash-latest

# Ollama (локальные модели) - рекомендуемые модели:
# llama3.1:8b - универсальная модель (4.9GB)
# gemma3:latest - быстрая модель (3.3GB) 
# deepseek-r1:7b - хорошая для рассуждений (4.7GB)
# tinyllama:latest - очень быстрая, маленькая (637MB)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Провайдер по умолчанию (openai, anthropic, deepseek, google, ollama)
DEFAULT_AI_PROVIDER=ollama

# Garmin Connect credentials (опционально - можно вводить в UI)
GARMIN_EMAIL=your_garmin_email@example.com
GARMIN_PASSWORD=your_garmin_password

# Intervals.icu planned workout sync (optional personal API key)
# For personal usage use username "API_KEY" and your API key as the password.
INTERVALS_ICU_API_KEY=your_intervals_icu_api_key_here
INTERVALS_ICU_ATHLETE_ID=0
INTERVALS_ICU_BASE_URL=https://intervals.icu

# Настройки базы данных
DATABASE_PATH=ai_trainer.db
# Canonical IANA timezone for prospective readiness/recovery cutoffs.
ATHLETE_TIMEZONE=Europe/Moscow

# Self-hosted Docker edge (Caddy)
# Leave DOMAIN empty for local HTTP on :8080; set a DNS name for automatic HTTPS.
DOMAIN=
BASIC_AUTH_USER=trainer
# Generate with: docker run --rm caddy:2 caddy hash-password --plaintext 'password'
# Keep the bcrypt value in single quotes because it contains dollar signs.
BASIC_AUTH_HASH=

# Acceptance mode (optional isolated runtime for safe browser verification)
ACCEPTANCE_MODE=0
ACCEPTANCE_AUTO_DEMO=0
ACCEPTANCE_DISABLE_GARMIN=0
ACCEPTANCE_LABEL=Acceptance Mode

# Dev-only sidebar tools (0 = hidden in product flow, 1 = show)
SHOW_DEVELOPMENT_TOOLS=0

# Пороги пользователя (опционально)
USER_FTP=250
USER_LTHR=170
USER_MAX_HR=185
