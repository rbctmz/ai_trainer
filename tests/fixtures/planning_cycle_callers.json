    {
      "path": "data/database.py",
      "function": "Database.get_planning_checkpoints_for_session",
      "line": 1732,
      "sql": "SELECT pc.id, pc.goal_type, pc.distance, pc.weeks_to_race, pc.checkpoint_data, pc.created_at FROM planning_checkpoints AS pc WHERE json_valid(pc.checkpoint_data) AND EXISTS ( SELECT 1 FROM json_tree(pc.checkpoint_data) AS node WHERE node.key = 'session_id' AND CAST(node.value AS TEXT) = ? ) ORDER BY pc.id DESC"
    },
    {
      "path": "data/database.py",
      "function": "Database.get_planning_checkpoints_for_sessions",
      "line": 1772,
      "sql": "SELECT DISTINCT CAST(node.value AS TEXT) AS matched_session_id, pc.id, pc.goal_type, pc.distance, pc.weeks_to_race, pc.checkpoint_data, pc.created_at FROM planning_checkpoints AS pc JOIN json_tree( CASE WHEN json_valid(pc.checkpoint_data) THEN pc.checkpoint_data ELSE '{}' END ) AS node ON node.key = 'session_id' WHERE CAST(node.value AS TEXT) IN ( SELECT CAST(value AS TEXT) FROM json_each(?) ) ORDER BY pc.id DESC"
    },
    {
      "path": "data/database.py",
      "function": "Database.get_latest_planning_checkpoints_for_dates",
      "line": 1843,
      "sql": "SELECT DISTINCT CAST(node.value AS TEXT) AS session_date, pc.id, pc.goal_type, pc.distance, pc.weeks_to_race, pc.checkpoint_data, pc.created_at FROM planning_checkpoints AS pc JOIN json_tree( CASE WHEN json_valid(pc.checkpoint_data) THEN pc.checkpoint_data ELSE '{}' END ) AS node ON node.key = 'date' JOIN json_each(?) AS requested ON CAST(node.value AS TEXT) = CAST(requested.key AS TEXT) WHERE node.fullkey LIKE '%session_templates%' AND datetime(pc.created_at) <= datetime( CAST(requested.value AS TEXT) ) ORDER BY datetime(pc.created_at) DESC, pc.id DESC"
    },
